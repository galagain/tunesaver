PUID=1000
PGID=1000
POLL_INTERVAL=5
WEB_PORT=8080
TIDDL_DOWNLOADS_PATH=./data/downloads/tiddl
BEATPORT_DOWNLOADS_PATH=./data/downloads/beatport
QOBUZ_DOWNLOADS_PATH=./data/downloads/qobuz
PUBLIC_URL=http://127.0.0.1:8080
ADMIN_EMAIL=admin
ADMIN_PASSWORD=changez-moi
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=tunesaver@galagain.com
SMTP_PASSWORD=changez-moi
SMTP_FROM=tunesaver@galagain.com
SMTP_STARTTLS=1
TUNESAVER_ALLOWED_HOSTS=127.0.0.1,localhost,::1
TIDDL_TRACK_VALUE_CENTS=129
BEATPORT_TRACK_VALUE_CENTS=149
QOBUZ_TRACK_VALUE_CENTS=149
# Optional Spotify API access for playlists not fully exposed by the public embed.
TUNESAVER_SPOTIFY_CLIENT_ID=
TUNESAVER_SPOTIFY_CLIENT_SECRET=
TUNESAVER_SPOTIFY_REFRESH_TOKEN=

# PostgreSQL provisioned by AppSilo; credentials stay in a separate private file.
TUNESAVER_DATABASE_ENV=/absolute/path/to/appsilo/apps/tunesaver/runtime.env
APPSILO_DB_NETWORK=replace-with-DB_NETWORK-from-appsilo
TUNESAVER_WEB_IMAGE=tunesaver:local
