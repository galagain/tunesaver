# Small application-only update retaining the deployed runtime and DB adapter.
FROM tunesaver:appsilo
COPY src/webapp.py src/playlist_sources.py src/catalog_matcher.py src/import_engine.py src/spotify_http.py export_playlist.py /app/
COPY web /app/web
COPY src/audio_retention.py src/feedback.py /app/
COPY src/stream_audio.py /app/
COPY src/download_fallback.py /app/

COPY src/account_transfer.py /app/
